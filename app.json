{
  "name": "UnZip Bot",
  "description": "Telegram's best Open Source UnZip Bot",
  "repository": "https://github.com/anujedits42-byte/UnZip-Bot",
  "logo": "https://files.catbox.moe/g2v4z3.jpg",
  "keywords": ["telegram", "bot", "pyrogram"],
  "env": {
    "BOT_TOKEN": {
      "description": "Telegram Bot Token",
      "required": true
    },
    "API_ID": {
      "description": "Telegram API ID",
      "required": true
    },
    "API_HASH": {
      "description": "Telegram API Hash",
      "required": true
    }
  },
  "addons": [
  ],
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ],
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "eco"
    }
  }
}

